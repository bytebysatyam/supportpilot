NODE_ENV=development
# Local development template only. Set production variables in Render/Vercel.
# Never copy a real database/Redis URL, JWT secret, or provider key into this file.

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Optional trusted-origin list: comma-separated exact origins, without paths.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# API base only: never append /health. Vercel embeds this value at build time.

# Database
# The credentials below are disposable local development placeholders.
DATABASE_URL=postgresql://supportpilot:supportpilot@localhost:5432/supportpilot?schema=public

# Redis / background jobs
REDIS_URL=redis://localhost:6379
SLA_SCAN_INTERVAL_MS=300000

# Authentication
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# AI
AI_PROVIDER=disabled
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
